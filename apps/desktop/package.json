{
  "name": "@enis/desktop",
  "productName": "Emplois du temps ENISo",
  "version": "1.0.0",
  "private": true,
  "description": "ENISo timetable → Word (desktop app)",
  "author": "ENISo",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && electron .",
    "stage": "node scripts/stage.js",
    "dist": "npm run build && npm run stage && electron-builder",
    "pack": "npm run build && npm run stage && electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "embedded-postgres": "17.11.0-beta.19"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "33.4.11",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "tn.enis.timetable",
    "productName": "Emplois du temps ENISo",
    "publish": [
      {
        "provider": "github",
        "owner": "mohamedalibenchiekh",
        "repo": "enis-timetable",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stage/api",
        "to": "api"
      },
      {
        "from": "stage/web",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "ENISo-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": ["dmg", "zip"],
      "artifactName": "ENISo-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "ENISo-${version}-${arch}.${ext}",
      "category": "Office"
    },
    "directories": {
      "output": "release"
    },
    "asar": false,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "language": "1036",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  }
}
