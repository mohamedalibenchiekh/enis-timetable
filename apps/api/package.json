{
  "name": "@enis/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "npm run build && vitest run test/integration.spec.ts",
    "test:verify": "node --loader ts-node/esm test/verify.mts",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:visual:update": "node --loader ts-node/esm test/visual/update-baselines.mts"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/typeorm": "^12.0.3",
    "cheerio": "^1.0.0",
    "docx": "^9.15.2",
    "jszip": "^3.10.2",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.6.6",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
